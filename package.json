{
    "name": "@sidekick-coder/zenith-kit",
    "version": "0.5.1",
    "license": "MIT",
    "description": "Package to use with zenith framework",
    "author": "Henrique Oliveira <henriqueoliwork@gmail.com>",
    "homepage": "https://github.com/sidekick-coder/zenith-kit",
    "type": "module",
    "bin": {
        "zenith": "./bin/zenith.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sidekick-coder/zenith-kit.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "imports": {
        "#client/*": "./src/client/*",
        "#server/*": "./src/server/*",
        "#shared/*": "./src/shared/*",
        "#build/*": "./src/build/*"
    },
    "exports": {
        "./shared": {
            "types": "./dist/shared/index.d.mts",
            "import": "./dist/shared/index.mjs",
            "require": "./dist/shared/index.js"
        },
        "./shared/*": {
            "types": "./dist/shared/*.d.mts",
            "import": "./dist/shared/*.mjs",
            "require": "./dist/shared/*.js"
        },
        "./server": {
            "types": "./dist/server/index.d.mts",
            "import": "./dist/server/index.mjs",
            "require": "./dist/server/index.js"
        },
        "./server/*": {
            "types": "./dist/server/*.d.mts",
            "import": "./dist/server/*.mjs",
            "require": "./dist/server/*.js"
        },
        "./client": {
            "types": "./dist/client/client/index.d.ts",
            "import": "./dist/client/index.es.js",
            "require": "./dist/client/index.es.js"
        },
        "./components": {
            "types": "./dist/components/src/client/components.d.ts",
            "import": "./dist/components/index.es.js",
            "require": "./dist/components/index.es.js"
        },
        "./styles.css": {
            "import": "./dist/components/styles.css",
            "require": "./dist/components/styles.css"
        },
        "./vite": {
            "import": "./vite/plugins/vite.js",
            "require": "./vite/plugins/vite.js"
        }
    },
    "scripts": {
        "build:server": "tsdown",
        "build:client": "vite build --config vite.client.config.ts",
        "build:components": "vite build --config vite.components.config.ts",
        "build": "npm-run-all build:*",
        "test:unit": "vitest --project unit",
        "test:int": "vitest --project int",
        "test": "npm run test:unit",
        "release": "node artisan.js release"
    },
    "peerDependencies": {
        "vee-validate": "^4.15.1",
        "vue": "^3.5.45",
        "vue-router": "^5.0.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.1",
        "@faker-js/faker": "^10.6.0",
        "@microsoft/api-extractor": "^7.60.1",
        "@types/bcrypt": "^6.0.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/supertest": "^7.2.1",
        "acorn-typescript": "^1.4.13",
        "better-sqlite3": "^13.2.0",
        "npm-run-all": "^4.1.5"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1169.0",
        "@aws-sdk/lib-storage": "^3.1169.0",
        "@aws-sdk/s3-request-presigner": "^3.1169.0",
        "@casl/ability": "^7.1.3",
        "@inquirer/prompts": "^8.8.0",
        "@rollup/pluginutils": "^5.5.1",
        "@tailwindcss/vite": "^4.3.5",
        "@types/express": "^5.0.6",
        "@types/js-yaml": "^4.0.9",
        "@types/lodash-es": "^4.17.12",
        "@types/mime": "^4.0.0",
        "@types/ms": "^2.1.0",
        "@types/node": "^26.6.6",
        "@types/node-schedule": "^2.1.8",
        "@types/qs": "^6.15.1",
        "@unhead/vue": "^3.4.3",
        "@vee-validate/valibot": "^4.15.1",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/language-core": "^3.3.14",
        "@vue/tsconfig": "^0.9.1",
        "@vueuse/router": "^15.0.0",
        "bcrypt": "^6.0.0",
        "chalk": "^6.0.1",
        "class-variance-authority": "^0.7.1",
        "cli-table3": "^0.6.5",
        "clsx": "^2.1.1",
        "commander": "^15.1.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "cosmiconfig": "^10.0.1",
        "date-fns": "^4.4.0",
        "dotenv": "^18.0.10",
        "embla-carousel-vue": "^8.6.0",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.12.1",
        "express": "^5.3.0",
        "fast-glob": "^3.3.3",
        "globals": "^17.14.0",
        "js-yaml": "^5.5.0",
        "kysely": "^0.29.9",
        "lodash-es": "^4.18.1",
        "lucide-vue-next": "^1.0.0",
        "mime": "^4.1.2",
        "ms": "^2.1.3",
        "mysql2": "^3.24.6",
        "node-schedule": "^2.1.2",
        "pg": "^8.23.1",
        "postcss": "^8.5.33",
        "postcss-selector-parser": "^7.2.1",
        "qs": "^6.17.1",
        "reka-ui": "^2.11.0",
        "supertest": "^7.3.2",
        "tailwind-merge": "^3.7.0",
        "tsdown": "^0.23.7",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2",
        "ulid": "^3.0.2",
        "undici": "^8.12.4",
        "valibot": "^1.5.0",
        "vaul-vue": "^0.4.1",
        "vee-validate": "^4.15.1",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^5.1.0",
        "vue-router": "^5.0.6",
        "vue-sonner": "^2.0.9"
    }
}
